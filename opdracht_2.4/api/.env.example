# Local development environment for the Customer Onboarding Portal API.
# Copy to .env and adjust. These are injected as container env vars in Azure by
# infra/resources.bicep — do not commit real values.

# Path prefix the shared APIM gateway strips before forwarding. Leave empty for
# direct local runs (uvicorn app.main:app --port 8001); set to /cop to mimic
# being served behind the gateway.
ROOT_PATH=

# Allowed browser origin for CORS (the Static Web App URL).
STATIC_WEBAPP_URL=http://localhost:5173

# Shared SQL server FQDN and the app database name. The API reads onboarding
# customer rows from this database, authenticating with the managed identity.
SQL_SERVER=
SQL_DATABASE=

# Application Insights connection string (unused by the skeleton).
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Stage 5: Microsoft Graph invite-time provisioning ---------------------
# The admin "invite user" endpoint provisions identities in the *identity*
# tenant's Microsoft Graph. In Azure the backend authenticates there without a
# stored secret: the user-assigned managed identity (AZURE_CLIENT_ID, set above
# in Azure) is federated to a dedicated Graph app registration (cop-graph-<env>)
# whose client ID is GRAPH_CLIENT_ID. IDENTITY_ENDPOINT/IDENTITY_HEADER are
# provided by the Container Apps runtime — do not set them locally. See
# docs/entra-configuration.md §3.E.
#
# Directory (tenant) ID of the identity tenant (where Graph is provisioned).
GRAPH_TENANT_ID=
# Application (client) ID of the dedicated Graph provisioning app (cop-graph-<env>).
GRAPH_CLIENT_ID=
# Object ID of the API app's service principal (Enterprise Applications entry) in
# the identity tenant — target of the Admin app-role assignment (ADR-0011).
GRAPH_API_SP_OBJECT_ID=
# OIDC authority host for the identity tenant. Defaults to the workforce host.
GRAPH_AUTHORITY_HOST=login.microsoftonline.com
# Portal URL an invited guest is redirected to after redemption. Falls back to
# STATIC_WEBAPP_URL when unset.
# INVITE_REDIRECT_URL=

# Authentication is handled by the platform, not the app: in Azure the container
# sits behind Container Apps built-in auth (EasyAuth), configured in
# infra/resources.bicep, which validates every Entra token and injects the
# caller's claims as the X-MS-CLIENT-PRINCIPAL header (see docs/adr/0010). The
# app reads that header and does authorization only — it needs no Entra tenant,
# audience, or issuer config here. Running locally there is no auth layer in
# front, so protected endpoints (e.g. /api/v1/portal/whoami) return 401 unless a test
# harness injects a fake principal header.
