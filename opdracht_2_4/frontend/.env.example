# Local development environment for the Customer Onboarding Portal frontend.
# Copy to .env.local (git-ignored). Vite exposes only VITE_-prefixed vars to the
# browser bundle, so these values are public — never put secrets here. They are
# non-secret Entra identifiers (see docs/authentication-implementation-plan.md
# "Entra reference values").
#
# For DEPLOYED builds you do NOT set these here: the pipeline reads them from the
# ba-9a-cop-<env> variable group. VITE_API_BASE_URL is set manually in that
# group; the three Entra values below are persisted into it by the infra stage
# from infra/environments/<env>/main.bicepparam (single source of truth). This
# file is only for local `npm run dev`.

# Base URL of the API through the shared APIM gateway. In dev deployments the
# pipeline injects this at build time.
VITE_API_BASE_URL=https://api-himal-dev.9altitudes.com/cop

# Identity (workforce) Entra tenant the SPA signs in against.
VITE_ENTRA_TENANT_ID=0ef950c5-f5cc-4a60-a2cc-22c8f7e10f52

# Application (client) ID of the SPA app registration (cop-spa-dev, public client).
VITE_SPA_CLIENT_ID=e91fba5f-0584-4d6e-a399-6562d7bff9fb

# Delegated scope exposed by the API app registration (cop-api-dev). MUST equal
# the platform's allowedAudiences so Container Apps built-in auth accepts the
# token (docs/adr/0010).
VITE_API_SCOPE=api://884c1ef6-d4ec-4098-9f56-2f2192e60d62/access_as_user

# Local-only escape hatch: set to "true" to skip Microsoft sign-in during local
# development (treats you as an admin). Never set this in a deployed build.
# VITE_DISABLE_AUTH=true
